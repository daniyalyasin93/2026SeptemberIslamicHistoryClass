series/visuals/*.trim.png

# per-slide PNG exports from series/preview.py
*_preview/
*_sheet.png
docs/research/read/

# video clips are too large for the repo; decks that embed them are not committed either
*.mp4

# review artefacts from S03_yemen/review_dump.py
S03_yemen/.build/sheets/
S03_yemen/.build/deck_dump.txt

