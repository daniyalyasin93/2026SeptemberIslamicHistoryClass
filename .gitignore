~$*.pptx
~$*.docx
# Python
__pycache__/
*.pyc
# Local scratch — per global convention, .claude notes are NOT committed
.claude/
series/data/
_*.png
sources/pdf/*
sources/archive*
# research notes render to PDF for reading (tools/render_note.py --all); the .md is canonical
docs/research/.render/
docs/research/*.pdf

